{
  "name": "yomutalk-plus",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/souhait0614/yomutalk-plus"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "deploy:web": "pnpm --filter web deploy",
    "preview:workers:web": "pnpm --filter web preview:workers",
    "dev": "turbo run dev",
    "lint": "concurrently --names 'root,repo' 'node:lint:root' 'node:lint:repo'",
    "lint:fix": "concurrently --names 'root,repo' 'node:lint:fix:root' 'node:lint:fix:repo'",
    "lint:fix:repo": "turbo run lint:fix",
    "lint:fix:root": "eslint . --fix --no-config-lookup --config eslint.config.ts",
    "lint:repo": "turbo run lint",
    "lint:root": "eslint . --no-config-lookup --config eslint.config.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "10.0.6",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
