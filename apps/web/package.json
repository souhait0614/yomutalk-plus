{
  "name": "web",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.2",
    "@internationalized/date": "3.12.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@vite-pwa/sveltekit": "1.1.0",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-static-copy": "4.1.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.1",
    "@repo/api": "workspace:*",
    "@repo/assets": "workspace:*",
    "@repo/novel-parser": "workspace:*",
    "@repo/tts": "workspace:*",
    "@tabler/icons-svelte": "3.50.0",
    "@tanstack/svelte-virtual": "3.13.49",
    "bits-ui": "2.20.2",
    "bowser": "2.15.0",
    "cborg": "6.1.5",
    "cn": "0.5.0",
    "dexie": "4.4.7",
